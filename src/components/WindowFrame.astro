---
// A browser or app window around a screenshot.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  /** Hide the drawn title bar when the screenshot already has its own. */
  bare?: boolean;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, title, bare = false, sizes = "(min-width: 1160px) 1100px, 100vw", eager = false, class: cls } = Astro.props;
---
<div class:list={["window", { "window--bare": bare }, cls]}>
  {
    !bare && (
      <div class="window__bar" aria-hidden="true">
        <span class="window__dots">
          <i />
          <i />
          <i />
        </span>
        {title && <span class="window__title">{title}</span>}
      </div>
    )
  }
  <Picture
    src={src}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[640, 960, 1440, 1920]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
</div>

<style>
  .window {
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: #0d0d14;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 80px -20px rgb(0 0 0 / 0.75);
  }
  .window__bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 34px;
    padding-inline: 0.85rem;
    background: #15151f;
    border-bottom: 1px solid var(--border);
  }
  .window__dots {
    display: flex;
    gap: 7px;
  }
  .window__dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a3a50;
  }
  .window__title {
    position: absolute;
    inset-inline: 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--faint);
    font-family: var(--font-mono);
    pointer-events: none;
  }
  .window :global(img) {
    width: 100%;
  }
  [dir="rtl"] .window__bar {
    direction: ltr;
  }
</style>
