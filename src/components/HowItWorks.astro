---
// "How it works": the three steps as a numbered line, then the five groups as
// a borderless index, so a sequence and a catalog get different shapes.
import Icon from "./Icon.astro";
import type { Translator } from "../i18n";
import { categoryIcon } from "../lib/catalog";

interface Props {
  t: Translator;
  total: number;
  categories: { key: string; count: number }[];
  guidesUrl: string;
}
const { t, total, categories, guidesUrl } = Astro.props;
const steps = t.keys("home.how.steps");
const groupsTitle = t("home.categories.title", { count: t.num(total) });
const allName = t("home.categories.all.name", { count: t.num(total) });
---
<div class="container">
  <div class="section-head">
    <h2 id="how-title">{t("home.how.title")}</h2>
    <p>{t("home.how.lead")}</p>
  </div>

  <ol class="flow">
    {steps.map((k, i) => (
      <li class="flow__step">
        <span class="flow__num num" aria-hidden="true">{i + 1}</span>
        <h3>{t(`home.how.steps.${k}.title`)}</h3>
        <p>{t(`home.how.steps.${k}.text`)}</p>
      </li>
    ))}
  </ol>
  <div class="index">
    <h3 class="index__title">{groupsTitle}</h3>
    <ul class="index__list">
      {categories.map((c) => (
        <li class="index__row">
          <span class="index__icon"><Icon name={categoryIcon[c.key]!} /></span>
          <span class="index__name">{t(`home.categories.${c.key}.name`)}</span>
          <span class="index__count num">{t("home.categories.count", { count: t.num(c.count) })}</span>
          <span class="index__text">{t(`home.categories.${c.key}.text`)}</span>
        </li>
      ))}
      <li class="index__row index__row--all">
        <a href={guidesUrl}>
          <span class="index__icon"><Icon name="arrow" class="flip" /></span>
          <span class="index__name">{allName}</span>
          <span class="index__text">{t("home.categories.all.text")}</span>
        </a>
      </li>
    </ul>
  </div>
</div>

<style>
  h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  :global([dir="rtl"]) :global(.flip) {
    transform: scaleX(-1);
  }

  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow::before {
    content: "";
    position: absolute;
    top: 1.05rem;
    inset-inline: 1.05rem 0;
    height: 1px;
    background: linear-gradient(to right, var(--accent-line), var(--border) 85%, transparent);
  }
  :global([dir="rtl"]) .flow::before {
    background: linear-gradient(to left, var(--accent-line), var(--border) 85%, transparent);
  }
  .flow__step {
    position: relative;
  }
  .flow__num {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: 700;
  }
  .flow__step p {
    margin-top: 0.45rem;
    color: var(--muted);
    max-width: 22rem;
  }
  .index {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid var(--border);
  }
  .index__title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .index__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index__row,
  .index__row--all a {
    display: grid;
    grid-template-columns: 1.5rem auto 1fr;
    column-gap: 0.75rem;
    align-items: baseline;
    align-content: start;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .index__row--all {
    display: block;
    padding: 0;
    border: 0;
  }
  .index__row--all a {
    color: var(--text);
    text-decoration: none;
  }
  .index__row--all a:hover .index__name {
    text-decoration: underline;
  }
  .index__row--all .index__name {
    grid-column: 2 / 4;
    color: var(--accent);
  }
  .index__icon {
    align-self: start;
    color: var(--accent);
    translate: 0 0.15rem;
  }
  .index__icon :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .index__name {
    font-weight: 600;
  }
  .index__count {
    color: var(--accent);
    font-size: 0.875rem;
  }
  .index__text {
    grid-column: 2 / 4;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .flow::before {
      top: 1.05rem;
      bottom: 1rem;
      inset-inline: 1.05rem auto;
      width: 1px;
      height: auto;
      background: var(--border-strong);
    }
    .flow__step {
      display: grid;
      grid-template-columns: 2.1rem 1fr;
      column-gap: 1.1rem;
    }
    .flow__num {
      grid-row: 1 / 3;
      margin-bottom: 0;
    }
    .flow__step p {
      grid-column: 2;
    }
    .index__list {
      grid-template-columns: 1fr;
    }
  }
</style>
