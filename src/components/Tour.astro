---
// "A look inside": a switcher over one large stage, one screen at a time with
// its caption beside it. Radio buttons, so it works without JavaScript; the
// first screen shows by default. Each screen links to the whole screen.
import type { ImageMetadata } from "astro";
import WindowFrame from "./WindowFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import type { Translator } from "../i18n";

interface Shot {
  key: string;
  crop: ImageMetadata;
  full: string;
  title?: string;
}
interface Props {
  t: Translator;
  web: readonly Shot[];
  desktop: Shot;
  android: Shot;
}
const { t, web, desktop, android } = Astro.props;
const all = [...web, desktop, android];
const ratio = (s: Shot) => (s.crop.width / s.crop.height).toFixed(3);
const sizes = "(min-width: 1160px) 760px, 100vw";
---
<div class="container">
  <div class="section-head">
    <h2 id="tour-title">{t("home.tour.title")}</h2>
    <p>{t("home.tour.lead")}</p>
  </div>

  <div class="sw">
    <fieldset class="sw__tabs">
      <legend class="visually-hidden">{t("home.tour.title")}</legend>
      {all.map((s, i) => (
        <>
          <input class="visually-hidden" type="radio" name="tour-screen" id={`sw-${s.key}`} checked={i === 0} />
          <label for={`sw-${s.key}`}>{t(`home.tour.${s.key}.title`)}</label>
        </>
      ))}
    </fieldset>
    {all.map((s) => (
      <figure class:list={["sw__panel", `sw__panel--${s.key}`]}>
        <figcaption>
          <h3>{t(`home.tour.${s.key}.title`)}</h3>
          <p>{t(`home.tour.${s.key}.text`)}</p>
        </figcaption>
        <div class="sw__stage">
          <div class="sw__frame" style={`--r: ${ratio(s)}`}>
            {s.key === "android" ? (
              <PhoneFrame src={s.crop} alt={t(`home.tour.${s.key}.alt`)} href={s.full} />
            ) : (
              <WindowFrame src={s.crop} alt={t(`home.tour.${s.key}.alt`)} title={s.title} bare={!s.title} href={s.full} sizes={sizes} />
            )}
          </div>
        </div>
      </figure>
    ))}
  </div>
</div>

<style>
  figure {
    margin: 0;
  }
  h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  figcaption p {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .sw__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.5rem;
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    width: fit-content;
    max-width: 100%;
    min-inline-size: 0;
  }
  .sw__tabs label {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .sw__tabs label:hover {
    color: var(--text);
  }
  .sw__tabs input:checked + label {
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }
  .sw__tabs input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sw__panel {
    display: none;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  .sw:has(#sw-fleet:checked) .sw__panel--fleet,
  .sw:has(#sw-catalog:checked) .sw__panel--catalog,
  .sw:has(#sw-payouts:checked) .sw__panel--payouts,
  .sw:has(#sw-desktop:checked) .sw__panel--desktop,
  .sw:has(#sw-android:checked) .sw__panel--android {
    display: grid;
  }
  .sw__stage {
    --h: 430px;
    display: grid;
    place-items: center;
    height: var(--h);
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse at 50% 0%, rgb(251 113 133 / 0.07), transparent 60%),
      var(--surface);
  }
  .sw__frame {
    width: min(100%, calc((var(--h) - 3rem - 34px) * var(--r)));
  }
  .sw__panel--android .sw__frame {
    width: min(100%, calc((var(--h) - 3rem - 20px) * var(--r)));
  }
  .sw__panel--android .sw__frame :global(.phone) {
    border-radius: 34px;
    padding: 8px;
  }
  .sw__panel--android .sw__frame :global(.phone img) {
    border-radius: 27px;
  }

  @media (max-width: 760px) {
    .sw__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: var(--radius-sm);
      width: 100%;
    }
    .sw__panel {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .sw__panel figcaption {
      order: 2;
    }
    .sw__stage {
      --h: 300px;
      padding: 1rem;
    }
  }
</style>
