---
import Logo from "./Logo.astro";
import type { Translator } from "../i18n";
import { docs, repo, feeds, social, CONTACT_EMAIL } from "../lib/links";
import { getData } from "../data";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
// The docs page for AI agents is linked only once it is published.
const { agentsDoc } = await getData();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href={t.href("/")} aria-label={t("nav.home")}>
          <Logo size={28} idSuffix="ftr" />
          <span>CashPilot</span>
        </a>
        <p>{t("footer.tagline")}</p>
      </div>
      <nav aria-labelledby="ft-product">
        <h2 id="ft-product">{t("footer.product")}</h2>
        <ul>
          <li><a href={t.href("/download/")}>{t("footer.download")}</a></li>
          <li><a href={docs.home}>{t("footer.docs")}</a></li>
          <li><a href={t.href("/referrals/")}>{t("footer.referrals")}</a></li>
          {agentsDoc && <li><a href={docs.forAgents}>{t("footer.agents")}</a></li>}
        </ul>
      </nav>
      <nav aria-labelledby="ft-project">
        <h2 id="ft-project">{t("footer.project")}</h2>
        <ul>
          <li><a href={repo.web}>{t("footer.web")}</a></li>
          <li><a href={repo.desktop}>{t("footer.desktop")}</a></li>
          <li><a href={repo.android}>{t("footer.android")}</a></li>
          <li><a href={repo.mcp}>{t("footer.mcp")}</a></li>
          <li><a href={feeds.releases}>{t("footer.feed")}</a></li>
          <li><a href={social.x} rel="me">{t("footer.x", { handle: social.xHandle })}</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="ft-about">
        <h2 id="ft-about">{t("footer.about")}</h2>
        <ul>
          <li><a href={t.href("/privacy/")}>{t("footer.privacy")}</a></li>
          <li><a href={t.href("/disclaimer/")}>{t("footer.disclaimer")}</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{t("footer.contact")}</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__legal">
      <p>{t("footer.legal")} <a href={t.href("/disclaimer/")}>{t("footer.disclaimer")}</a></p>
      <p>{t("footer.credit")}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    padding-block: 3.5rem 2.5rem;
    font-size: 0.9375rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2rem;
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .site-footer__brand p {
    margin-top: 0.8rem;
    max-width: 22rem;
    color: var(--muted);
  }
  .site-footer h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--faint);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .site-footer li a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer li a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .site-footer__legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.4rem;
    color: var(--faint);
    font-size: 0.875rem;
  }
  .site-footer__legal a {
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
