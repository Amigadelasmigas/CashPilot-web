---
// Suggests the visitor's language when this page exists in it. It never
// redirects. The strings come from each target locale, so the suggestion is
// written in the language it offers. site.ts shows it; without JavaScript it
// stays hidden.
import { AVAILABLE, localizedPath, useT, type Translator } from "../i18n";

interface Props {
  t: Translator;
  route: string;
}
const { t, route } = Astro.props;
const offers = Object.fromEntries(
  AVAILABLE.filter((l) => l.code !== t.locale.code).map((l) => {
    const lt = useT(l);
    return [l.code, { href: localizedPath(l, route), dir: l.dir, text: lt("lang.suggest"), switch: lt("lang.switch"), dismiss: lt("lang.dismiss") }];
  }),
);
---
{
  Object.keys(offers).length > 0 && (
    <div class="lang-suggest" data-lang-suggest data-current={t.locale.code} hidden>
      <script is:inline type="application/json" set:html={JSON.stringify(offers)} />
      <div class="container lang-suggest__inner">
        <p data-text />
        <div class="lang-suggest__actions">
          <a class="btn btn--primary btn--sm" data-switch href="#" />
          <button class="btn btn--ghost btn--sm" type="button" data-dismiss />
        </div>
      </div>
    </div>
  )
}

<style>
  .lang-suggest {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .lang-suggest__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block: 0.7rem;
  }
  .lang-suggest p {
    color: var(--text);
    font-size: 0.9688rem;
  }
  .lang-suggest__actions {
    display: flex;
    gap: 0.5rem;
  }
</style>
