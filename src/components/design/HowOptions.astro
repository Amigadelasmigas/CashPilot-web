---
// Design options for "How it works" and the five groups (DESIGN_OPTION=1|2|3).
// Only one survives once an option is chosen; the others get deleted.
import Icon from "../Icon.astro";
import type { Translator } from "../../i18n";
import { categoryIcon } from "../../lib/catalog";

interface Props {
  t: Translator;
  opt: string;
  total: number;
  categories: { key: string; count: number }[];
  guidesUrl: string;
}
const { t, opt, total, categories, guidesUrl } = Astro.props;
const steps = t.keys("home.how.steps");
const groupsTitle = t("home.categories.title", { count: t.num(total) });
const allName = t("home.categories.all.name", { count: t.num(total) });
---
<div class="container">
  <div class="section-head">
    <h2 id="how-title">{t("home.how.title")}</h2>
    <p>{t("home.how.lead")}</p>
  </div>

  {
    opt === "1" && (
      <>
        <ol class="flow">
          {steps.map((k, i) => (
            <li class="flow__step">
              <span class="flow__num num" aria-hidden="true">{i + 1}</span>
              <h3>{t(`home.how.steps.${k}.title`)}</h3>
              <p>{t(`home.how.steps.${k}.text`)}</p>
            </li>
          ))}
        </ol>
        <div class="index">
          <h3 class="index__title">{groupsTitle}</h3>
          <ul class="index__list">
            {categories.map((c) => (
              <li class="index__row">
                <span class="index__icon"><Icon name={categoryIcon[c.key]!} /></span>
                <span class="index__name">{t(`home.categories.${c.key}.name`)}</span>
                <span class="index__count num">{t("home.categories.count", { count: t.num(c.count) })}</span>
                <span class="index__text">{t(`home.categories.${c.key}.text`)}</span>
              </li>
            ))}
            <li class="index__row index__row--all">
              <a href={guidesUrl}>
                <span class="index__icon"><Icon name="arrow" class="flip" /></span>
                <span class="index__name">{allName}</span>
                <span class="index__text">{t("home.categories.all.text")}</span>
              </a>
            </li>
          </ul>
        </div>
      </>
    )
  }

  {
    opt === "2" && (
      <div class="split2">
        <ol class="timeline">
          {steps.map((k, i) => (
            <li class="timeline__step">
              <span class="timeline__num num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{t(`home.how.steps.${k}.title`)}</h3>
                <p>{t(`home.how.steps.${k}.text`)}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="panel">
          <h3 class="panel__title">{groupsTitle}</h3>
          <ul class="panel__list">
            {categories.map((c) => (
              <li class="panel__row">
                <span class="panel__icon"><Icon name={categoryIcon[c.key]!} /></span>
                <span class="panel__body">
                  <span class="panel__head">
                    <span class="panel__name">{t(`home.categories.${c.key}.name`)}</span>
                    <span class="panel__count num">{t.num(c.count)}</span>
                  </span>
                  <span class="panel__text">{t(`home.categories.${c.key}.text`)}</span>
                </span>
              </li>
            ))}
          </ul>
          <a class="panel__all" href={guidesUrl}>
            {allName} <Icon name="arrow" class="flip" />
          </a>
        </div>
      </div>
    )
  }

  {
    opt === "3" && (
      <ol class="flow3">
        {steps.map((k, i) => (
          <li class="flow3__step">
            <span class="flow3__num num" aria-hidden="true">{i + 1}</span>
            <h3>{t(`home.how.steps.${k}.title`)}</h3>
            <p>{t(`home.how.steps.${k}.text`)}</p>
            {k === "pick" && (
              <div class="chips">
                <p class="chips__title">{groupsTitle}</p>
                <ul class="chips__list">
                  {categories.map((c) => (
                    <li class="chip" title={t(`home.categories.${c.key}.text`)}>
                      <Icon name={categoryIcon[c.key]!} />
                      <span>{t(`home.categories.${c.key}.name`)}</span>
                      <span class="chip__count num">{t.num(c.count)}</span>
                    </li>
                  ))}
                </ul>
                <a class="chips__all" href={guidesUrl}>
                  {allName} <Icon name="arrow" class="flip" />
                </a>
              </div>
            )}
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  :global([dir="rtl"]) :global(.flip) {
    transform: scaleX(-1);
  }

  /* Option 1: a numbered flow on one line, then a borderless index. */
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow::before {
    content: "";
    position: absolute;
    top: 1.05rem;
    inset-inline: 1.05rem 0;
    height: 1px;
    background: linear-gradient(to right, var(--accent-line), var(--border) 85%, transparent);
  }
  :global([dir="rtl"]) .flow::before {
    background: linear-gradient(to left, var(--accent-line), var(--border) 85%, transparent);
  }
  .flow__step {
    position: relative;
  }
  .flow__num {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: 700;
  }
  .flow__step p {
    margin-top: 0.45rem;
    color: var(--muted);
    max-width: 22rem;
  }
  .index {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid var(--border);
  }
  .index__title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .index__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index__row,
  .index__row--all a {
    display: grid;
    grid-template-columns: 1.5rem auto 1fr;
    column-gap: 0.75rem;
    align-items: baseline;
    align-content: start;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .index__row--all {
    display: block;
    padding: 0;
    border: 0;
  }
  .index__row--all a {
    color: var(--text);
    text-decoration: none;
  }
  .index__row--all a:hover .index__name {
    text-decoration: underline;
  }
  .index__row--all .index__name {
    grid-column: 2 / 4;
    color: var(--accent);
  }
  .index__icon {
    align-self: start;
    color: var(--accent);
    translate: 0 0.15rem;
  }
  .index__icon :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .index__name {
    font-weight: 600;
  }
  .index__count {
    color: var(--accent);
    font-size: 0.875rem;
  }
  .index__text {
    grid-column: 2 / 4;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Option 2: the steps as a vertical timeline, the groups in one panel beside them. */
  .split2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    column-gap: 1.1rem;
    padding-bottom: 2rem;
  }
  .timeline__step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2.4rem;
    bottom: 0.3rem;
    inset-inline-start: 1.05rem;
    width: 1px;
    background: var(--border-strong);
  }
  .timeline__num {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    color: var(--accent);
    font-weight: 700;
  }
  .timeline__step h3 {
    padding-top: 0.25rem;
  }
  .timeline__step p {
    margin-top: 0.4rem;
    color: var(--muted);
  }
  .panel {
    padding: 1.4rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .panel__title {
    margin-bottom: 0.4rem;
  }
  .panel__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel__row {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    column-gap: 0.85rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  .panel__icon {
    color: var(--accent);
    translate: 0 0.1rem;
  }
  .panel__icon :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .panel__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel__name {
    font-weight: 600;
  }
  .panel__count {
    color: var(--accent);
    font-weight: 600;
  }
  .panel__text {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .panel__all,
  .chips__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .panel__all:hover,
  .chips__all:hover {
    text-decoration: underline;
  }
  .panel__all :global(.icon),
  .chips__all :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  /* Option 3: three columns, and the groups sit inside step 2, where you pick them. */
  .flow3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow3__step {
    padding-top: 1.25rem;
    border-top: 2px solid var(--border-strong);
  }
  .flow3__step:nth-child(2) {
    border-top-color: var(--accent);
  }
  .flow3__num {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--accent);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .flow3__step > p {
    margin-top: 0.45rem;
    color: var(--muted);
  }
  .chips {
    margin-top: 1.25rem;
  }
  .chips__title {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem 0.3rem 0.55rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .chip :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }
  .chip__count {
    color: var(--accent);
    font-weight: 600;
  }
  .chips__all {
    margin-top: 0.85rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .flow,
    .flow3 {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .flow::before {
      top: 1.05rem;
      bottom: 1rem;
      inset-inline: 1.05rem auto;
      width: 1px;
      height: auto;
      background: var(--border-strong);
    }
    .flow__step {
      display: grid;
      grid-template-columns: 2.1rem 1fr;
      column-gap: 1.1rem;
    }
    .flow__num {
      grid-row: 1 / 3;
      margin-bottom: 0;
    }
    .flow__step p {
      grid-column: 2;
    }
    .index__list {
      grid-template-columns: 1fr;
    }
    .split2 {
      grid-template-columns: 1fr;
    }
    .flow3__step {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      column-gap: 1rem;
    }
    .flow3__num {
      grid-row: 1 / 4;
      font-size: 2rem;
    }
    .flow3__step > :not(.flow3__num) {
      grid-column: 2;
    }
  }
</style>
