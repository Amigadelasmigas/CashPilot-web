---
// A plain <details> menu of links: it works without JavaScript. site.ts closes
// it on Escape or an outside click and stores the choice in localStorage.
import Icon from "./Icon.astro";
import { AVAILABLE, localizedPath, type Translator } from "../i18n";

interface Props {
  t: Translator;
  route: string;
}
const { t, route } = Astro.props;
const current = t.locale;
// With one language there is nothing to pick, so the picker is not shown.
const show = AVAILABLE.length > 1;
---
{show && (
<details class="lang" data-lang-picker>
  <summary class="lang__button">
    <Icon name="globe" />
    <span class="visually-hidden">{t("lang.label")}:</span>
    <span class="lang__code">{current.code.split("-")[0]!.toUpperCase()}</span>
    <Icon name="chevron" class="lang__chev" />
  </summary>
  <div class="lang__menu" role="group" aria-label={t("lang.label")}>
    <ul>
      {
        AVAILABLE.map((l) => (
          <li>
            <a
              href={localizedPath(l, route)}
              hreflang={l.code}
              lang={l.code}
              dir={l.dir}
              data-lang-choice={l.code}
              aria-current={l.code === current.code ? "true" : undefined}
            >
              {l.name}
              {l.code === current.code && <Icon name="check" />}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>
)}

<style>
  .lang {
    position: relative;
  }
  .lang__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    user-select: none;
  }
  .lang__button::-webkit-details-marker {
    display: none;
  }
  .lang__button:hover,
  .lang[open] .lang__button {
    color: var(--text);
    background: var(--surface-2);
  }
  .lang__button :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .lang__button :global(.lang__chev) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .lang__menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    min-width: 13rem;
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.55);
  }
  .lang__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 40px;
    padding: 0.45rem 0.7rem;
    border-radius: 7px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .lang__menu a:hover {
    background: var(--surface-2);
  }
  .lang__menu a[aria-current] {
    color: var(--accent);
  }
  .lang__menu :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
</style>
