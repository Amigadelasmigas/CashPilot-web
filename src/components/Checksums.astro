---
import CodeBlock from "./CodeBlock.astro";
import type { Translator } from "../i18n";
import { downloads, repo } from "../lib/links";

interface Props {
  t: Translator;
  os: "windows" | "macos" | "linux";
  files: string[];
  version: string;
  sums: Record<string, string>;
  verify: (file: string) => string;
}
const { t, os, files, version, sums, verify } = Astro.props;
const rows = files.filter((f) => sums[f]);
---
<details class="checksums">
  <summary>{t("download.checksums.title", { version })}</summary>
  <div class="checksums__body">
    {
      rows.length > 0 && (
        <dl dir="ltr">
          {rows.map((f) => (
            <div>
              <dt class="mono">{f}</dt>
              <dd class="mono">{sums[f]}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <p>{t(`download.${os}.verify`)}</p>
    <CodeBlock t={t} id={`verify-${os}`} code={verify(files[0]!)} />
    <p class="checksums__links">
      <a href={downloads.sums}>{t("download.checksums.all")}</a>
      <a href={repo.desktop}>{t("download.source")}</a>
      <a href={`${repo.desktop}/releases`}>{t("download.allReleases")}</a>
    </p>
  </div>
</details>

<style>
  .checksums {
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .checksums summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    min-height: 32px;
  }
  .checksums summary:hover {
    color: var(--text);
  }
  .checksums__body {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .checksums dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .checksums dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .checksums dd {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .checksums p {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .checksums__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
