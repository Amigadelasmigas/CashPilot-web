---
import DownloadPage from "../../../components/DownloadPage.astro";
import { OSES, type Os } from "../../../lib/catalog";
import { localeFromPath, localeParams, useT } from "../../../i18n";

export const getStaticPaths = () => localeParams().flatMap((p) => OSES.map((os) => ({ params: { ...p.params, os } })));
const t = useT(localeFromPath(Astro.params.locale));
const os = Astro.params.os as Os;
---
<DownloadPage t={t} os={os} />
