---
import Base from "../../layouts/Base.astro";
import { localeFromPath, localeParams, useT } from "../../i18n";

export const getStaticPaths = () => localeParams();
const t = useT(localeFromPath(Astro.params.locale));
---
<Base t={t} route="/disclaimer/" title={t("disclaimer.metaTitle")} description={t("disclaimer.description")}>
  <section class="page-hero">
    <div class="container">
      <h1>{t("disclaimer.title")}</h1>
      <p>{t("disclaimer.lead")}</p>
    </div>
  </section>
  <div class="container page-body">
    <div class="prose">
    {
      t.keys("disclaimer.items").map((k) => (
        <section aria-labelledby={`h-${k}`}>
          <h2 id={`h-${k}`}>{t(`disclaimer.items.${k}.title`)}</h2>
          <p>{t(`disclaimer.items.${k}.text`)}</p>
        </section>
      ))
    }
    </div>
  </div>
</Base>

<style>
  .page-body {
    padding-bottom: var(--section);
  }
  .page-body section:first-child h2 {
    margin-top: 0.5rem;
  }
</style>
