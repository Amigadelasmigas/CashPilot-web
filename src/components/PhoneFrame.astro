---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
  /** Wrap the screenshot in a link, for example to the full-size image. */
  href?: string;
}
const { src, alt, class: cls, eager = false, href } = Astro.props;
const widths = [...[300, 450, 640].filter((w) => w < src.width), src.width];
const Wrap = href ? "a" : "div";
---
<div class:list={["phone", cls]}>
  <Wrap class="phone__shot" href={href}>
    <Picture
      src={src}
      alt={alt}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={widths}
      sizes="(min-width: 800px) 300px, 70vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </Wrap>
</div>

<style>
  .phone {
    width: 100%;
    max-width: 300px;
    padding: 10px;
    border-radius: 42px;
    background: linear-gradient(160deg, #24243a, #12121c);
    border: 1px solid var(--border-strong);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
  }
  .phone__shot {
    display: block;
  }
  .phone :global(img) {
    width: 100%;
    border-radius: 33px;
  }
</style>
